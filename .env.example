# Postgres (use same values in docker-compose or your host)
# Async driver for the app (Alembic uses sync postgresql+psycopg in alembic.ini)
DATABASE_URL=postgresql+psycopg_async://noisebins:noisebins@localhost:5432/noisebins

# App
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# JWT for fastapi-users (min 32 chars for HS256)
USERS_JWT_SECRET=change-me-users-jwt-secret-min-32-chars-long

# Optional: comma-separated origins for CORS (leave empty for same-origin only)
CORS_ORIGINS=

# Blob storage: local dev directory (absolute or relative to cwd)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/blobs
PUBLIC_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_BYTES=5242880

# Vision assist (phase 11) — off by default
VISION_ASSIST_ENABLED=false

# Single sign-on with Noiseport (or the Noisebridge Keycloak realm) over OpenID Connect.
# See docs/noiseport-sso.md. Register a confidential client with redirect URI
#   ${PUBLIC_BASE_URL}/auth/noiseport/callback
NOISEPORT_OAUTH_ENABLED=false
NOISEPORT_DISPLAY_NAME=Noiseport
# Noiseport: https://api.<portal-host>/openid   Keycloak: https://<sso-host>/realms/<realm>
NOISEPORT_ISSUER=
NOISEPORT_CLIENT_ID=
NOISEPORT_CLIENT_SECRET=
NOISEPORT_SCOPES=openid profile email
# Optional: override discovered endpoints
NOISEPORT_AUTHORIZE_URL=
NOISEPORT_TOKEN_URL=
NOISEPORT_USERINFO_URL=
# Browser session cookie; Secure is on automatically when PUBLIC_BASE_URL is https
SESSION_COOKIE_NAME=noisebins_session
